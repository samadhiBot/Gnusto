{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Starts and runs the main game loop.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GnustoEngine\/documentation\/GnustoEngine","doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameEngine"]]},"variants":[{"paths":["\/documentation\/gnustoengine\/gameengine\/run()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"run()","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"externalID":"s:12GnustoEngine04GameB0C3runyyYaF","modules":[{"name":"GnustoEngine"}],"roleHeading":"Instance Method","extendedModule":"GnustoEngine","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is the primary entry point for beginning and playing the game."},{"type":"text","text":" "},{"type":"text","text":"It performs the following sequence:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets up the "},{"type":"codeVoice","code":"IOHandler"},{"type":"text","text":" (e.g., preparing the console or UI)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prints the game’s title and introduction message."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Marks the player’s starting location as visited and describes it.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Enters the main turn-based loop, which continues until "},{"type":"codeVoice","code":"shouldQuit"},{"type":"text","text":" becomes "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Each iteration of the loop involves:"},{"type":"text","text":" "},{"type":"text","text":"a. Displaying the status line (current location, score, moves) via "},{"type":"codeVoice","code":"showStatus()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"b. Processing a single player turn via "},{"type":"codeVoice","code":"processTurn()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"After the loop terminates (e.g., player quits), performs teardown for the "},{"code":"IOHandler","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Game developers typically do not call this method directly after initialization;","type":"text"},{"text":" ","type":"text"},{"text":"it is intended to be the engine’s top-level execution flow.","type":"text"}]}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameEngine\/run()"},"references":{"doc://GnustoEngine/documentation/GnustoEngine/GameEngine":{"title":"GameEngine","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"GameEngine"}],"role":"symbol","url":"\/documentation\/gnustoengine\/gameengine","navigatorTitle":[{"kind":"identifier","text":"GameEngine"}],"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameEngine","abstract":[{"type":"text","text":"The main orchestrator for an interactive fiction game, responsible for managing"},{"type":"text","text":" "},{"type":"text","text":"the game’s state, running the primary game loop, and coordinating interactions"},{"type":"text","text":" "},{"type":"text","text":"between the player (via an "},{"type":"codeVoice","code":"IOHandler"},{"type":"text","text":"), the command "},{"type":"codeVoice","code":"Parser"},{"type":"text","text":", and the various"},{"type":"text","text":" "},{"type":"text","text":"game logic handlers ("},{"type":"codeVoice","code":"ActionHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"ItemEventHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"LocationEventHandler"},{"type":"text","text":")."}],"kind":"symbol","type":"topic"},"doc://GnustoEngine/documentation/GnustoEngine":{"abstract":[],"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine","title":"GnustoEngine","role":"collection","url":"\/documentation\/gnustoengine","kind":"symbol","type":"topic"},"doc://GnustoEngine/documentation/GnustoEngine/GameEngine/run()":{"title":"run()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"}],"type":"topic","url":"\/documentation\/gnustoengine\/gameengine\/run()","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameEngine\/run()","role":"symbol","abstract":[{"type":"text","text":"Starts and runs the main game loop."}]}}}