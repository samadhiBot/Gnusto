"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"code":"LocationEventContext","type":"codeVoice"},{"text":" provides event handlers with structured access to the event being processed,","type":"text"},{"text":" ","type":"text"},{"text":"the location it’s associated with, and the game engine for accessing other game state. This eliminates","type":"text"},{"text":" ","type":"text"},{"text":"the need for event handlers to manually retrieve the subject location.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example usage:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["static let forestHandler = LocationEventHandler { context in","    return await context.event.match {","        beforeTurn(verb: .look) { _ in","            let timeOfDay = try await context.engine.global(.timeOfDay) ?? \"day\"","            if timeOfDay == \"night\" && !await context.location.isLit {","                ActionResult(\"The forest is too dark to see anything.\")","            } else {","                ActionResult(\"Sunlight filters through the ancient trees.\")","            }","        }","        whenAfterTurn { _ in","            \/\/ Trigger forest sounds after any action","            ActionResult(\"You hear rustling in the bushes.\")","        }","    }","}"]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/gnustoengine\/locationeventcontext"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/GnustoEngine\/s8SendableP","doc:\/\/GnustoEngine\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"kind":"symbol","references":{"doc://GnustoEngine/documentation/GnustoEngine":{"abstract":[],"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine","title":"GnustoEngine","role":"collection","url":"\/documentation\/gnustoengine","kind":"symbol","type":"topic"},"doc://Gnusto