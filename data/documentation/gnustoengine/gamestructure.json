{"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"GnustoEngine"}],"title":"Game Structure and Dynamic Behavior"},"identifier":{"url":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameStructure","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Organizing Your Game","type":"heading","level":2,"anchor":"Organizing-Your-Game"},{"type":"paragraph","inlineContent":[{"identifier":"gnusto-proxies.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Gnusto separates your game into two layers: ","type":"text"},{"inlineContent":[{"text":"static definitions","type":"text"}],"type":"strong"},{"text":" that describe your game world’s initial state, and ","type":"text"},{"inlineContent":[{"text":"dynamic proxies","type":"text"}],"type":"strong"},{"text":" that represent the living, evolving world during gameplay. This architecture lets you write clean, declarative game content while enabling sophisticated runtime behaviors through event handlers and computed properties.","type":"text"}]},{"text":"The Game Blueprint","type":"heading","level":3,"anchor":"The-Game-Blueprint"},{"type":"paragraph","inlineContent":[{"text":"Your ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameBlueprint","type":"reference"},{"text":" serves as the entry point, containing essential metadata and the initial game configuration. Most of the game blueprint can be generated automatically by the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GnustoAutoWiringPlugin","type":"reference"},{"text":".","type":"text"}]},{"code":["public struct CloakOfDarkness: GameBlueprint {","    public let title = \"Cloak of Darkness\"","    public let abbreviatedTitle = \"Cloak\"","    public let introduction = \"\"\"","        A basic IF demonstration.","","        Hurrying through the rainswept November night, you're glad to see the","        bright lights of the Opera House...","        \"\"\"","    public let release = \"0.0.3\"","    public let maximumScore = 2","    public let player = Player(in: .foyer)","","    \/\/ Note: All game content registration (items, locations, handlers, etc.)","    \/\/ is automatically handled by GnustoAutoWiringPlugin","}"],"type":"codeListing","syntax":"swift"},{"text":"Structuring Your World","type":"heading","level":3,"anchor":"Structuring-Your-World"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Organize your "},{"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/Item","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/Location","type":"reference","isActive":true},{"type":"text","text":" definitions in logical groupings that represent your game world. The framework is flexible, so choose the structure that makes sense for your game’s scope and complexity."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Large games","type":"text"}],"type":"strong"},{"text":" like ","type":"text"},{"inlineContent":[{"type":"text","text":"Zork"}],"type":"emphasis"},{"text":" benefit from regional organization, with special files for complex entities:","type":"text"}]},{"code":["Zork1\/","├── main.swift","├── World","│   ├── BeneathHouse.swift     # Underground areas","│   ├── Dam.swift              # Dam complex","│   ├── Forest.swift           # Forest region","│   ├── ...","│   ├── Thief.swift            # Complex NPC with behaviors","│   └── Troll.swift            # Another complex NPC","├── Zork1.swift                # Game blueprint","└── ZorkMessenger.swift        # Custom Zork-specific responses"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Smaller games"}],"type":"strong"},{"type":"text","text":" like "},{"inlineContent":[{"type":"text","text":"Cloak of Darkness"}],"type":"emphasis"},{"type":"text","text":" can fit everything in a single world file:"}]},{"code":["CloakOfDarkness\/","├── CloakOfDarkness.swift      # Game blueprint","├── OperaHouse.swift           # All locations and items","└── main.swift"],"type":"codeListing","syntax":null},{"text":"Defining Static Content","type":"heading","level":3,"anchor":"Defining-Static-Content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your static definitions describe the initial state of the world – how things are when the adventure begins. For example, inside the Opera House in "},{"type":"emphasis","inlineContent":[{"text":"Cloak of Darkness","type":"text"}]},{"type":"text","text":", there is a cloakroom, and in that cloakroom there is a small brass hook screwed to the wall:"}]},{"code":["struct OperaHouse {","    \/\/ ...","    let cloakroom = Location(.cloakroom)","        .name(\"Cloakroom\")","        .description(","            \"\"\"","            The walls of this small room were clearly once lined with hooks,","            though now only one remains. The exit is a door to the east.","            \"\"\"","        )","        .east(.foyer)","        .inherentlyLit","","    let hook = Item(.hook)","        .adjectives(\"small\", \"brass\")","        .in(.cloakroom)","        .omitDescription","        .isSurface","        .name(\"small brass hook\")","        .synonyms(\"peg\")","    \/\/ ...","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"These definitions are just the starting point. Once the game begins, everything becomes dynamic.","type":"text"}]},{"text":"The Living World: Dynamic Proxies","type":"heading","level":2,"anchor":"The-Living-World-Dynamic-Proxies"},{"type":"paragraph","inlineContent":[{"text":"During gameplay, you never work with static ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/Item"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/Location"},{"text":" objects directly. Instead, the engine provides ","type":"text"},{"inlineContent":[{"text":"proxy objects","type":"text"}],"type":"strong"},{"text":" – ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/ItemProxy"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/LocationProxy"},{"text":", and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/PlayerProxy"},{"text":" – that represent the current, evolving state of your world.","type":"text"}]},{"text":"Why Proxies?","type":"heading","level":3,"anchor":"Why-Proxies"},{"type":"paragraph","inlineContent":[{"text":"Proxies bridge the gap between your static definitions and the dynamic game world. They:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Track current state"}]},{"text":": Is the door open? Is the room lit? Where is the sword now?","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Apply context","type":"text"}]},{"type":"text","text":": A room’s lighting depends on "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"type":"text","text":" light sources present, not just a static flag"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enable intervention"}]},{"type":"text","text":": Event handlers can modify behaviors on the fly"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compute properties"}]},{"type":"text","text":": Descriptions can change based on game state"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ensure safety","type":"text"}]},{"text":": Handle concurrent access in Swift 6’s strict concurrency model","type":"text"}],"type":"paragraph"}]}]},{"text":"Static vs. Dynamic Properties","type":"heading","level":3,"anchor":"Static-vs-Dynamic-Properties"},{"type":"paragraph","inlineContent":[{"text":"Learning this distinction is key to understanding Gnusto:","type":"text"}]},{"text":"Static properties","type":"heading","level":4,"anchor":"Static-properties"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Defined at compile time","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Initial flags: ","type":"text"},{"type":"codeVoice","code":".isTakable"},{"text":", ","type":"text"},{"type":"codeVoice","code":".isLightSource"},{"text":", ","type":"text"},{"type":"codeVoice","code":".isContainer"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Starting descriptions, names, adjectives and synonyms"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Base item properties and initial locations"}],"type":"paragraph"}]}]},{"text":"Dynamic properties","type":"heading","level":4,"anchor":"Dynamic-properties"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Computed at runtime through proxies"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isLit","type":"codeVoice"},{"text":": Considers all light sources, darkness effects, and conditions","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isVisible"},{"text":": Accounts for darkness, container states, and concealment","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"description","type":"codeVoice"},{"text":": Can change based on world state via property computers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"currentLoad","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"isEmpty","type":"codeVoice"},{"text":": Reflect actual container contents","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"isProvidingLight","type":"codeVoice"},{"type":"text","text":": Whether an item is actually illuminating (e.g. lit lamp vs. unlit lamp)"}],"type":"paragraph"}]}]},{"level":2,"text":"Making Things Happen: Event Handlers","anchor":"Making-Things-Happen-Event-Handlers","type":"heading"},{"inlineContent":[{"type":"text","text":"Event handlers intercept player commands and add dynamic behaviors to your items and locations. They work exclusively with proxy objects to access and modify the current game state."}],"type":"paragraph"},{"level":3,"text":"Item Event Handlers","anchor":"Item-Event-Handlers","type":"heading"},{"inlineContent":[{"type":"text","text":"Make items respond intelligently to player actions:"}],"type":"paragraph"},{"syntax":"swift","code":["let cloakHandler = ItemEventHandler(for: .cloak) {","    before(.drop, .insert) { context, _ in","        guard await context.player.location == .cloakroom else {","            throw ActionResponse.feedback(","                \"This isn't the best place to leave a smart cloak lying around.\"","            )","        }","        return nil  \/\/ Pass control back to default action handling","    }","","    after { context, command in","        guard await context.player.location == .cloakroom else {","            return nil","        }","","        if command.hasIntent(.drop, .insert) {","            var changes = [","                await context.location(.bar).setFlag(.isLit)","            ]","            if await context.player.score < 1 {","                changes.append(await context.player.updateScore(by: 1))","            }","            return ActionResult(changes: changes)","        }","","        if command.hasIntent(.take) {","            return await ActionResult(","                context.location(.bar).clearFlag(.isLit)","            )","        }","","        return nil","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Notice how the handler uses proxies throughout: "},{"type":"codeVoice","code":"context.player"},{"type":"text","text":" is a "},{"type":"reference","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/PlayerProxy","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"context.player.location"},{"type":"text","text":" is a "},{"type":"reference","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/LocationProxy","isActive":true},{"type":"text","text":", and these proxies know the current state of the world."}],"type":"paragraph"},{"level":3,"text":"Location Event Handlers","anchor":"Location-Event-Handlers","type":"heading"},{"inlineContent":[{"type":"text","text":"Create rooms that respond to their environment:"}],"type":"paragraph"},{"syntax":"swift","code":["let barHandler = LocationEventHandler(for: .bar) {","    \/\/ First: if location is lit, yield to normal processing","    beforeTurn { context, _ in","        if await context.location.isLit {","            return ActionResult.yield","        }","        return nil  \/\/ not handled, try next matcher","    }","","    \/\/ Second: handle north movement in dark","    beforeTurn(.move) { context, command in","        if command.direction == .north {","            return ActionResult.yield","        } else {","            return ActionResult(","                \"Blundering around in the dark isn't a good idea!\",","                await context.engine.adjustGlobal(.barMessageDisturbances, by: 2)","            )","        }","    }","","    \/\/ Third: handle meta commands in dark","    beforeTurn(.meta) { _, _ in","        return ActionResult.yield","    }","","    \/\/ Fourth: catch-all for other commands in dark","    beforeTurn { context, _ in","        return ActionResult(","            \"In the dark? You could easily disturb something!\",","            await context.engine.adjustGlobal(.barMessageDisturbances, by: 1)","        )","    }","}"],"type":"codeListing"},{"level":2,"text":"Computed Properties","anchor":"Computed-Properties","type":"heading"},{"inlineContent":[{"text":"While event handlers respond to commands, property computers calculate dynamic values on demand:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let kitchenComputer = LocationComputer(for: .kitchen) {","    locationProperty(.description) { context in","        let kitchenWindow = await context.item(.kitchenWindow)","        let windowState = await kitchenWindow.isOpen ? \"open\" : \"slightly ajar\"","        return .string(","            \"\"\"","            You are in the kitchen of the white house. A table seems to","            have been used recently for the preparation of food. A passage","            leads to the west and a dark staircase can be seen leading","            upward. A dark chimney leads down and to the east is a small","            window which is \\(windowState).","            \"\"\"","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The proxy system seamlessly integrates computed properties – when you access "},{"code":"kitchen.description","type":"codeVoice"},{"type":"text","text":", the proxy checks for a computed property first, and falls back to the static definition if none exists."}],"type":"paragraph"},{"text":"Time-Based Behaviors: Daemons","anchor":"Time-Based-Behaviors-Daemons","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Daemons run independently of player actions, using proxies to implement autonomous behaviors:"}],"type":"paragraph"},{"code":["let swordDaemon = Daemon { engine, state in","    let currentLocation = await engine.player.location","    var newGlowLevel: SwordBrightness = .notGlowing","","    \/\/ Check for monsters in current location (highest priority)","    for item in await currentLocation.items where await item.isCharacter {","        newGlowLevel = .glowingBrightly","        break","    }","","    if newGlowLevel != .glowingBrightly {","        \/\/ Check adjacent locations for monsters","        for exit in await currentLocation.exits {","            guard let destination = exit.destinationID else { continue }","            let adjacentLocation = await engine.location(destination)","            for item in await adjacentLocation.items where await item.isCharacter {","                newGlowLevel = .glowingFaintly","                break","            }","        }","    }","","    \/\/ Always update the glow level and show message if glowing","    let currentGlowLevel = state.getPayload(as: SwordBrightness.self) ?? .notGlowing","","    \/\/ Do nothing if the glow level has not changed","    if newGlowLevel == currentGlowLevel { return nil }","","    \/\/ Update and announce the glow level if it has changed","    return try ActionResult(","        newGlowLevel.description,","        .updateDaemonState(","            daemonID: .swordDaemon,","            daemonState: state.updatingPayload(newGlowLevel)","        )","    )","}"],"syntax":"swift","type":"codeListing"},{"text":"Putting It All Together","anchor":"Putting-It-All-Together","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The power of Gnusto’s architecture becomes clear when these pieces work together:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"You define","type":"text"}]},{"type":"text","text":" clean, declarative items and locations"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The auto-wiring plugin generates","type":"text"}]},{"text":" strongly-typed IDs and connective boilerplate","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Proxies provide"}]},{"type":"text","text":" access to the living, dynamic world"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Event handlers"}],"type":"strong"},{"text":" add sophisticated behaviors","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Property computers","type":"text"}],"type":"strong"},{"text":" make descriptions and states contextual","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Daemons and Fuses","type":"text"}]},{"text":" create autonomous, time-based effects","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This separation keeps your code organized, maintainable, and powerful – letting you focus on crafting compelling interactive fiction rather than wrestling with infrastructure."}]},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"State Changes and the Action Pipeline","type":"text"}]},{"type":"text","text":": Safely modifying game state"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Advanced Event Handling"}]},{"type":"text","text":": Complex command interception patterns"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Custom Properties"}]},{"type":"text","text":": Extending the proxy system with your own computations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Combat Systems"}]},{"type":"text","text":": Building interactive combat with proxies and handlers"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gnustoengine\/gamestructure"]}],"abstract":[{"text":"Learn how to organize your game world and bring it to life with dynamic proxies and event handlers.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GnustoEngine\/documentation\/GnustoEngine"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GnustoEngine/documentation/GnustoEngine":{"abstract":[],"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine","title":"GnustoEngine","role":"collection","url":"\/documentation\/gnustoengine","kind":"symbol","type":"topic"},"doc://GnustoEngine/documentation/GnustoEngine/ItemProxy":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ItemProxy","kind":"identifier"}],"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/ItemProxy","type":"topic","role":"symbol","abstract":[{"text":"A lightweight proxy that provides dynamic property access for items through the GameEngine.","type":"text"}],"title":"ItemProxy","navigatorTitle":[{"text":"ItemProxy","kind":"identifier"}],"url":"\/documentation\/gnustoengine\/itemproxy","kind":"symbol"},"doc://GnustoEngine/documentation/GnustoEngine/PlayerProxy":{"role":"symbol","title":"PlayerProxy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerProxy"}],"abstract":[{"type":"text","text":"A lightweight proxy that provides dynamic property access for the player character through the GameEngine."}],"navigatorTitle":[{"kind":"identifier","text":"PlayerProxy"}],"url":"\/documentation\/gnustoengine\/playerproxy","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/PlayerProxy","kind":"symbol","type":"topic"},"doc://GnustoEngine/documentation/GnustoEngine/Location":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Location"}],"kind":"symbol","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/Location","url":"\/documentation\/gnustoengine\/location","title":"Location","abstract":[{"text":"Represents a distinct place or room within the game world that the player can visit.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Location"}],"type":"topic","role":"symbol"},"doc://GnustoEngine/documentation/GnustoEngine/GnustoAutoWiringPlugin":{"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GnustoAutoWiringPlugin","title":"Gnusto Auto-Wiring Plugin","type":"topic","url":"\/documentation\/gnustoengine\/gnustoautowiringplugin","kind":"article","role":"article","abstract":[{"text":"Eliminate boilerplate with automatic ID generation and game setup.","type":"text"}]},"doc://GnustoEngine/documentation/GnustoEngine/GameBlueprint":{"url":"\/documentation\/gnustoengine\/gameblueprint","title":"GameBlueprint","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GameBlueprint","kind":"identifier"}],"navigatorTitle":[{"text":"GameBlueprint","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/GameBlueprint","abstract":[{"type":"text","text":"Defines the foundational structure and core components of a Gnusto-powered game."}],"kind":"symbol"},"doc://GnustoEngine/documentation/GnustoEngine/Item":{"url":"\/documentation\/gnustoengine\/item","navigatorTitle":[{"text":"Item","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/Item","title":"Item","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Item","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Represents an interactive object or entity within the game world, such as a brass lantern,"},{"type":"text","text":" "},{"type":"text","text":"a rusty key, a treasure chest, or even a non-player character (NPC)."}],"kind":"symbol"},"gnusto-proxies.png":{"type":"image","identifier":"gnusto-proxies.png","variants":[{"traits":["1x","light"],"url":"\/images\/GnustoEngine\/gnusto-proxies.png"}],"alt":"Gnusto Proxies"},"doc://GnustoEngine/documentation/GnustoEngine/LocationProxy":{"type":"topic","title":"LocationProxy","url":"\/documentation\/gnustoengine\/locationproxy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocationProxy"}],"navigatorTitle":[{"kind":"identifier","text":"LocationProxy"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A lightweight proxy that provides dynamic property access for locations through the GameEngine."}],"identifier":"doc:\/\/GnustoEngine\/documentation\/GnustoEngine\/LocationProxy"}}}